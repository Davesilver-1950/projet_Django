# ==============================================================================
# SmartRoute CM — Variables d'environnement (exemple)
# Copier ce fichier en `.env` à la racine du dépôt avant le lancement.
# Ne JAMAIS committer le fichier `.env` réel dans Git.
# ==============================================================================

# Django
SECRET_KEY=remplacer-par-une-cle-secrete-aleatoire-locale
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données : "postgresql" (par défaut / cahier des charges) ou "sqlite" (repli local rapide)
DB_ENGINE=postgresql
POSTGRES_DB=smartroute_cm
POSTGRES_USER=smartroute_user
POSTGRES_PASSWORD=mot_de_passe_fictif_local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# CORS (origines autorisées pour Vue.js / Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite
VITE_API_BASE_URL=http://127.0.0.1:8000/api
